{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
, "src/app/signup.jsx", "src/app/home.jsx", "src/app/index.jsx", "src/app/_layout.jsx", "src/app/alert.jsx", "src/app/explore.jsx", "src/app/schedule.jsx", "firebaseConfig.jsx"  ]
}
